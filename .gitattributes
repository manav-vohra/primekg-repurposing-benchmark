* text=auto

*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Never let checkout settings rewrite scientific reference bytes.
artifacts/frozen/** -text
tests/fixtures/data/** -text
*.npz binary
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
